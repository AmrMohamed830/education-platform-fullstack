# Server port (used for local development; in Vercel serverless, this is handled automatically)
PORT=5000

# Environment mode: development | production
NODE_ENV=production

# MongoDB Atlas connection string (ensure 0.0.0.0/0 is whitelisted in Atlas Network Access for Vercel)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# JWT signing secret key
JWT_SECRET_KEY=your_super_secret_jwt_key_here

# Frontend production URL (for CORS and cross-domain authentication on Vercel)
FRONTEND_URL=https://your-frontend-app.vercel.app

# Supabase Storage Configuration (Server-Side Only - Never expose to Frontend)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Two-Bucket Architecture:
# 1. Public bucket for course covers and user avatars (publicly readable via CDN)
SUPABASE_PUBLIC_BUCKET=education-public

# 2. Private bucket for downloadable lesson resources (strictly protected via signed URLs & enrollment checks)
SUPABASE_PRIVATE_BUCKET=education-private
