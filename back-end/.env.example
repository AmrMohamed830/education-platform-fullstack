# Server port (automatically assigned by cloud providers like Render / Railway)
PORT=5000

# Environment mode: development | production
NODE_ENV=production

# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# JWT signing secret key
JWT_SECRET_KEY=your_super_secret_jwt_key_here

# Frontend production URL (for CORS and cross-domain authentication)
FRONTEND_URL=https://your-frontend-app.vercel.app

